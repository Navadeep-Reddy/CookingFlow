*.mov
*.mkv
*.webm
*.avi
*.m4v
*.mpg
*.mpeg
*.3gp
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.wma
*.aiff

# Scratch caches
__pycache__/
*.pyc
node_modules/
.DS_Store
Thumbs.db
